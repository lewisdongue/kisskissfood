CREATE TABLE public.call_sessions (
  id uuid NOT NULL DEFAULT uuid_generate_v4(),
  user1_id uuid,
  user2_id uuid,
  started_at timestamp with time zone DEFAULT now(),
  ended_at timestamp with time zone,
  duration integer,
  CONSTRAINT call_sessions_pkey PRIMARY KEY (id),
  CONSTRAINT call_sessions_user1_id_fkey FOREIGN KEY (user1_id) REFERENCES public.users(id),
  CONSTRAINT call_sessions_user2_id_fkey FOREIGN KEY (user2_id) REFERENCES public.users(id)
